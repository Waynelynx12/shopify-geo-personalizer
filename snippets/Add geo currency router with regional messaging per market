{% assign current_url = canonical_url %}
{% assign country = localization.country.iso_code %}
{% assign language = localization.language.iso_code %}

<link rel="alternate" hreflang="x-default" href="{{ current_url }}" />

{% for market in localization.available_countries %}
  {% assign market_code = market.iso_code | downcase %}
  {% assign lang_code = language | downcase %}
  {% assign hreflang_value = lang_code | append: '-' | append: market_code %}

  <link
    rel="alternate"
    hreflang="{{ hreflang_value }}"
    href="{{ current_url }}?country={{ market.iso_code }}"
  />
{% endfor %}
